#!/bin/sh
# ==============================================================================
# 95-wwan-mtu
# 蜂窝接口（wwan*）上线或更新时优化 txqueuelen=100，并保留运营商动态下发的 MTU
# 说明：定制版 quectel-CM-M 已修复 MBIM 动态 MTU 字节序与放行逻辑，会自动按
#       运营商/漫游核心网下发值设置 MTU（如 1340/1460/1500），此处不再写死覆盖，
#       仅对超出标准上限（>1500）的异常值做保底收敛。
# ==============================================================================
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0

case "$DEVICE" in
	wwan*)
		cur_mtu=$(cat "/sys/class/net/$DEVICE/mtu" 2>/dev/null)
		if [ -n "$cur_mtu" ] && [ "$cur_mtu" -gt 1500 ]; then
			ip link set dev "$DEVICE" mtu 1500 2>/dev/null
		fi
		ip link set dev "$DEVICE" txqueuelen 100 2>/dev/null
		;;
esac
