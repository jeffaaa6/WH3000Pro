#!/bin/sh
# ==============================================================================
# 99-wh3000pro-custom
# 首次启动（uci-defaults）自动修正 WH3000 Pro 的 PWM 风扇 hwmon 路径
# 背景：实机上 2.5G PHY 传感器可能占用 hwmon1，导致 pwmfan 实际位于 hwmon2；
#       通过开机动态探测真实路径，可避免不同 Linux 内核下路径写死失效。
# ==============================================================================

detect_pwmfan_file() {
    # 优先从 platform/pwm-fan 路径查找
    for f in /sys/devices/platform/pwm-fan/hwmon/hwmon*/pwm1; do
        if [ -e "$f" ]; then
            echo "$f"
            return 0
        fi
    done

    # 兜底扫描 /sys/class/hwmon 下名称为 pwmfan 的节点
    for d in /sys/class/hwmon/hwmon*; do
        if [ -r "$d/name" ] && [ "$(cat "$d/name" 2>/dev/null)" = "pwmfan" ] && [ -e "$d/pwm1" ]; then
            echo "$d/pwm1"
            return 0
        fi
    done

    return 1
}

if [ -f /etc/config/fancontrol ]; then
    FAN_PWM="$(detect_pwmfan_file || true)"
    if [ -n "$FAN_PWM" ]; then
        uci set fancontrol.settings.fan_file="$FAN_PWM"
    fi

    if [ -e /sys/devices/virtual/thermal/thermal_zone0/temp ]; then
        uci set fancontrol.settings.thermal_file='/sys/devices/virtual/thermal/thermal_zone0/temp'
    fi

    uci set fancontrol.settings.enabled='1'
    uci set fancontrol.settings.temp_div='1000'
    uci set fancontrol.settings.start_temp='25'
    uci set fancontrol.settings.start_speed='35'
    uci set fancontrol.settings.max_speed='100'
    uci set fancontrol.settings.reverse='0'
    uci commit fancontrol
fi

# 固定 LuCI 为简体中文，避免浏览器 zh-Hans-CN 匹配失败回退英文
if [ -f /etc/config/luci ]; then
    uci set luci.main.lang='zh_cn'
    uci commit luci
fi

# 关闭流卸载与 FullCone NAT，避免干扰 USB 5G (wwan0) 与透明代理（实测纯软转发可打满千兆）
if [ -f /etc/config/firewall ]; then
    uci set firewall.@defaults[0].flow_offloading='0'
    uci set firewall.@defaults[0].flow_offloading_hw='0'
    uci set firewall.@defaults[0].fullcone='0'
    uci commit firewall
fi

# 若内核已内置 BBR 拥塞控制，则默认持久化开启
if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null || \
   [ -d /etc/sysctl.d ]; then
    mkdir -p /etc/sysctl.d
    cat << 'EOF' > /etc/sysctl.d/99-bbr.conf
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=bbr
EOF
fi

exit 0
