# ==============================================================================
# Huasifei WH3000 Pro (eMMC) - coolsnowwolf/lede 精简选包种子配置
# 说明：只保留机型与核心功能包，云编译阶段由 `make defconfig` 自动解算全部依赖。
# 如需交互式调整，可在 Actions 触发表单中勾选 `ssh_menuconfig=true`，执行
# `make menuconfig` 后运行 `./scripts/diffconfig.sh` 导出精简配置覆盖本文件。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 目标平台与机型（MT7981B / Filogic 820 / eMMC）
# ------------------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_huasifei_wh3000-pro=y

# ------------------------------------------------------------------------------
# 2. LuCI 基础界面、主题、简体中文与 Lua 兼容层
#    使用上游最新版 jerrykuku/luci-theme-argon (v3.x，内置主题设置) 作为默认主题，
#    同时保留 luci-theme-design 可在后台随时切换
# ------------------------------------------------------------------------------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-theme-design=y
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_lua=y

# ------------------------------------------------------------------------------
# 3. 蜂窝 / USB 3.0 / 5G 模组内核驱动（主线标准驱动，适配 T99W368 MBIM 等模式）
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_usbutils=y

# iPhone USB 个人热点
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y

# ------------------------------------------------------------------------------
# 4. 5G 模组拨号、AT 交互与短信管理（来自 FUjr/QModem feed）
#    显式使用主线通用 QMI 驱动，避免拉入 LEDE 老旧 out-of-tree QMI 驱动引发 6.18 编译/驱动冲突
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
# CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan is not set
# CONFIG_PACKAGE_qmodem_INCLUDE_SEAL is not set
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-i18n-qmodem-zh-cn=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-i18n-qmodem-sms-zh-cn=y
CONFIG_PACKAGE_quectel-CM-5G-M=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_sms-tool_q=y
CONFIG_PACKAGE_ubus-at-daemon=y

# ------------------------------------------------------------------------------
# 5. PWM 风扇温控（来自 JiaY-shi/fancontrol feed）
#    注：hwmon 节点编号由 files/etc/uci-defaults/99-wh3000pro-custom 开机自动修正
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_fancontrol=y
CONFIG_PACKAGE_luci-app-fancontrol=y
CONFIG_PACKAGE_luci-i18n-fancontrol-zh-cn=y

# ------------------------------------------------------------------------------
# 6. eMMC / USB 存储与基础运维工具
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ------------------------------------------------------------------------------
# 7. 代理与 DNS（LEDE 默认使用 fw4；MosDNS 负责 DNS 分流，关闭 SmartDNS）
#    PassWall 精简保留 Xray、Sing-Box（及配套 Geoview）
# ------------------------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_smartdns is not set
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set

# ------------------------------------------------------------------------------
# 8. 容器、存储、终端、文件共享、组网、流量监控与守护
# ------------------------------------------------------------------------------
# Docker 与磁盘管理（可将 eMMC 剩余分区挂载作为 Docker 数据盘）
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# 网页终端与轻量文件管理
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y

# 局域网高速 SMB 文件共享与网络断线看门狗
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y

# Tailscale 异地组网（社区版 LuCI 支持网页一键更新 tailscaled）
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

# 流量监控（保留 nlbwmon 历史统计 + 新增 Bandix 实时按设备流量监控）
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-i18n-bandix-zh-cn=y

# ------------------------------------------------------------------------------
# 9. 精简移除不需要的 LEDE 默认组件（KMS 激活与传统 FTP 服务）
# ------------------------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_vsftpd-alt is not set
