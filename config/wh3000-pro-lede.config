# ==============================================================================
# Huasifei WH3000 Pro (eMMC) - coolsnowwolf/lede 精简选包种子配置
# 说明：只保留机型与核心功能包，云编译阶段由 `make defconfig` 自动解算全部依赖。
# 如需交互式调整，可在 Actions 触发表单中勾选 `ssh_menuconfig=true`，执行
# `make menuconfig` 后运行 `./scripts/diffconfig.sh` 导出精简配置覆盖本文件。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 目标平台与机型（MT7981B / Filogic 820 / eMMC）
# ------------------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_huasifei_wh3000-pro=y

# ------------------------------------------------------------------------------
# 2. LuCI 基础界面、简体中文与 Lua 兼容层
#    保留 lua 与 luci-compat，便于后续迁移自定义 T99W368 Lua 适配脚本
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_lua=y

# ------------------------------------------------------------------------------
# 3. 蜂窝 / USB 3.0 / 5G 模组内核驱动（主线标准驱动，适配 T99W368 MBIM 等模式）
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_usbutils=y

# iPhone USB 个人热点
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y

# ------------------------------------------------------------------------------
# 4. 5G 模组拨号、AT 交互与短信管理（来自 FUjr/QModem feed）
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-i18n-qmodem-zh-cn=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-i18n-qmodem-sms-zh-cn=y
CONFIG_PACKAGE_quectel-CM-5G-M=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_sms-tool_q=y
CONFIG_PACKAGE_ubus-at-daemon=y

# ------------------------------------------------------------------------------
# 5. PWM 风扇温控（来自 JiaY-shi/fancontrol feed）
#    注：hwmon 节点编号由 files/etc/uci-defaults/99-wh3000pro-custom 开机自动修正
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_fancontrol=y
CONFIG_PACKAGE_luci-app-fancontrol=y
CONFIG_PACKAGE_luci-i18n-fancontrol-zh-cn=y

# ------------------------------------------------------------------------------
# 6. eMMC / USB 存储与基础运维工具
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y

# 代理与 DNS（LEDE 默认使用 fw4）
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
