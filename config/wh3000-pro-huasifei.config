# ==============================================================================
# Huasifei WH3000 Pro (eMMC) - huasifei-source/huasifei-source 精简选包种子配置
# 说明：huasifei-source 的 filogic.mk 已为 huasifei_wh3000-pro-emmc 预选
#       MT7981 开源无线驱动、全套 USB 蜂窝内核驱动、luci-app-qmodem、
#       luci-app-fancontrol、luci-app-mwan3 与 luci-app-samba4。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 目标平台与机型（huasifei-source 中 eMMC 版机型名为 huasifei_wh3000-pro-emmc）
# ------------------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_huasifei_wh3000-pro-emmc=y

# ------------------------------------------------------------------------------
# 2. 必保留避坑项：禁用 kmod-crypto-eip（华思飞提交说明启用会导致开机内核 panic）
# ------------------------------------------------------------------------------
# CONFIG_PACKAGE_kmod-crypto-eip is not set

# ------------------------------------------------------------------------------
# 3. 简体中文与 Lua 兼容层（便于后续运行自定义 T99W368 Lua 脚本）
# ------------------------------------------------------------------------------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_lua=y

# ------------------------------------------------------------------------------
# 4. 蜂窝扩展、iPhone USB 个人热点与基础运维工具
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_generic-qmi-wwan=y
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_vendor-qmi-wwan is not set
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-app-fancontrol=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
